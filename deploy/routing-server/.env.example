# Copy to `.env` before starting the routing server stack.
#
#   docker compose pull
#   docker compose up -d --force-recreate
#
# After changing JAVA_XMX, always recreate so the JVM picks up the new heap.

# Host folder for OSM PBF and GraphHopper graph cache (can grow to many GB).
WAYFINDER_ROUTING_DATA_PATH=./storage/data

# Host port (default avoids conflicting with geocoding on 18182).
WAYFINDER_ROUTING_SERVER_PORT=18382

# Java heap for GraphHopper import and routing.
# Default 2g is only enough for tiny smoke tests (Monaco / Andorra).
# Entire United States (us-latest): set 32g or higher — host must have that much free RAM.
# Large countries (DE, FR, CA): often 8g–16g.
JAVA_XMX=32g

# Logging: ALL, FINEST, FINER, FINE/DEBUG, CONFIG, INFO, WARNING, SEVERE/ERROR, OFF
LOG_LEVEL=INFO

# Override to pin a specific release (default: latest from main).
# WAYFINDER_ROUTING_SERVER_IMAGE=ghcr.io/kennethbrewer3/wayfinder-routing-server:latest
