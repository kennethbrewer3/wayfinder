# Copy to `.env` in this directory before starting the server stack.
#
#   docker compose pull
#   docker compose up -d

WAYFINDER_DATA_PATH=./storage/data

# Optional: mount PMTiles from an existing folder shared with another app.
# WAYFINDER_PMTILES_HOST_PATH=/mnt/shared/maps/pmtiles
# WAYFINDER_PMTILES_MOUNT_OPTIONS=:ro

# Optional: mount marker icon SVGs elsewhere (default: {WAYFINDER_DATA_PATH}/marker-icons)
# WAYFINDER_MARKER_ICON_HOST_PATH=/mnt/shared/wayfinder/marker-icons

# Optional: mount marker photo attachments elsewhere
# (default: {WAYFINDER_DATA_PATH}/marker-attachments)
# WAYFINDER_MARKER_ATTACHMENT_HOST_PATH=/mnt/shared/wayfinder/marker-attachments

WAYFINDER_DB_PORT=18090
WAYFINDER_REDIS_PORT=18091
SERVERPOD_API_SERVER_PORT=18080
SERVERPOD_WEB_SERVER_PORT=18082
SERVERPOD_INSIGHTS_SERVER_PORT=18081

# Public URLs for browsers and remote clients.
#
# Direct LAN access (no reverse proxy): use the host LAN IP and the mapped ports above.
SERVERPOD_API_SERVER_PUBLIC_HOST=192.168.1.10
SERVERPOD_API_SERVER_PUBLIC_PORT=18080
SERVERPOD_API_SERVER_PUBLIC_SCHEME=http
SERVERPOD_WEB_SERVER_PUBLIC_HOST=192.168.1.10
SERVERPOD_WEB_SERVER_PUBLIC_PORT=18082
SERVERPOD_WEB_SERVER_PUBLIC_SCHEME=http
#
# Reverse proxy (Caddy, nginx, Traefik, etc.): use the public hostname and HTTPS on 443.
# Keep the host ports above unchanged — the proxy forwards to localhost:18080 / :18082.
# SERVERPOD_API_SERVER_PUBLIC_HOST=api.example.com
# SERVERPOD_API_SERVER_PUBLIC_PORT=443
# SERVERPOD_API_SERVER_PUBLIC_SCHEME=https
# SERVERPOD_WEB_SERVER_PUBLIC_HOST=web.example.com
# SERVERPOD_WEB_SERVER_PUBLIC_PORT=443
# SERVERPOD_WEB_SERVER_PUBLIC_SCHEME=https

# Required — choose strong passwords and keep .env out of version control.
POSTGRES_PASSWORD=change-me-postgres-password
REDIS_PASSWORD=change-me-redis-password

# Auth secrets for Serverpod (required in Docker — the GHCR image has no passwords.yaml).
# Generate each value: openssl rand -base64 32
SERVERPOD_PASSWORD_serviceSecret=change-me-service-secret
SERVERPOD_PASSWORD_emailSecretHashPepper=change-me-email-pepper
SERVERPOD_PASSWORD_jwtHmacSha512PrivateKey=change-me-jwt-signing-key
SERVERPOD_PASSWORD_jwtRefreshTokenHashPepper=change-me-jwt-refresh-pepper

# Override to pin a specific release (default: latest from main).
# WAYFINDER_SERVER_IMAGE=ghcr.io/kennethbrewer3/wayfinder-server:latest

# Spare TOC / viewer appliance: reject all writes (REST + RPC).
# WAYFINDER_READ_ONLY=1
