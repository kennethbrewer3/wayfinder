# Copy to `.env` before starting the geocoding server stack.
#
#   docker compose pull
#   docker compose up -d

POSTGRES_PASSWORD=your-strong-postgres-password

# Host folder for geocoding Postgres data (can be large — planet import is tens of GB).
WAYFINDER_GEOCODING_DATA_PATH=./storage/data

# Host ports (defaults avoid conflicting with the main Wayfinder server on 18080/18082/18090).
WAYFINDER_GEOCODING_DB_PORT=18290
SERVERPOD_API_SERVER_PORT=18180
SERVERPOD_WEB_SERVER_PORT=18182
SERVERPOD_INSIGHTS_SERVER_PORT=18181

# Public URLs for browsers and remote clients.
#
# Direct LAN access (no reverse proxy): use the host LAN IP and the mapped ports above.
SERVERPOD_API_SERVER_PUBLIC_HOST=192.168.1.10
SERVERPOD_API_SERVER_PUBLIC_PORT=18180
SERVERPOD_API_SERVER_PUBLIC_SCHEME=http
SERVERPOD_WEB_SERVER_PUBLIC_HOST=192.168.1.10
SERVERPOD_WEB_SERVER_PUBLIC_PORT=18182
SERVERPOD_WEB_SERVER_PUBLIC_SCHEME=http
#
# Reverse proxy (Caddy, nginx, Traefik, etc.): use the public hostname and HTTPS on 443.
# Keep the host ports above unchanged — the proxy forwards to localhost:18180 / :18182.
# SERVERPOD_API_SERVER_PUBLIC_HOST=geo-api.example.com
# SERVERPOD_API_SERVER_PUBLIC_PORT=443
# SERVERPOD_API_SERVER_PUBLIC_SCHEME=https
# SERVERPOD_WEB_SERVER_PUBLIC_HOST=geo-web.example.com
# SERVERPOD_WEB_SERVER_PUBLIC_PORT=443
# SERVERPOD_WEB_SERVER_PUBLIC_SCHEME=https

# Override to pin a specific release (default: latest from main).
# WAYFINDER_GEOCODING_SERVER_IMAGE=ghcr.io/kennethbrewer3/wayfinder-geocoding-server:latest

# Optional: enable anonymous crowdsource uploads from the geocoding server.
# GEOCODING_CROWDSOURCE_GITHUB_TOKEN=
# GEOCODING_CROWDSOURCE_GITHUB_REPO=kennethbrewer3/wayfinder
# GEOCODING_CROWDSOURCE_GITHUB_FILE=geocoding-crowdsource/contributions.json
