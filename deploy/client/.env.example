# Copy to `.env` in this directory before starting the client.
#
# URLs must be reachable from the user's browser (server LAN IP or DNS).
#
#   docker compose pull
#   docker compose up -d
#
# Or use ./start.sh (recommended on hosts where Compose hangs at "Creating").

WAYFINDER_CLIENT_PORT=8080

# Direct LAN access (no reverse proxy):
WAYFINDER_API_URL=http://192.168.1.10:18080
WAYFINDER_WEB_URL=http://192.168.1.10:18082
WAYFINDER_GEOCODING_WEB_URL=http://192.168.1.10:18182
WAYFINDER_ROUTING_WEB_URL=http://192.168.1.10:18382

# Reverse proxy (Caddy, nginx, Traefik, etc.) — use public HTTPS hostnames:
# WAYFINDER_CLIENT_PORT=9080
# WAYFINDER_API_URL=https://api.example.com
# WAYFINDER_WEB_URL=https://web.example.com
# WAYFINDER_GEOCODING_WEB_URL=https://geo-web.example.com
# WAYFINDER_ROUTING_WEB_URL=https://routing.example.com

# Override to pin a specific release (default: latest from main).
# WAYFINDER_CLIENT_IMAGE=ghcr.io/kennethbrewer3/wayfinder-client:latest
